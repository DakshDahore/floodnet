{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "floodlock-backend-standby",
  "main": "src/index.js",
  "compatibility_date": "2026-10-23",
  "observability": {
    "enabled": true
  },
  "ai": {
    "binding": "AI"
  },
  "kv_namespaces": [
    {
      "binding": "FLOODLOCK_KV",
      "id": "64ec69f748d3430fb3d34b8d6e59d8c3"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SECURITY_STATE_DO",
        "class_name": "SecurityStateDO",
        "script_name": "floodlock-backend"
      },
      {
        "name": "BILLING_STATE_DO",
        "class_name": "BillingStateDO",
        "script_name": "floodlock-backend"
      },
      {
        "name": "CIRCUIT_BREAKER_DO",
        "class_name": "CircuitBreakerDO",
        "script_name": "floodlock-backend"
      }
    ]
  },
  "vars": {
    "GROQ_MODEL": "llama-3.1-8b-instant",
    "GEMINI_MODEL": "gemini-2.5-flash",
    "ALLOWED_ORIGINS": "https://floodlock.pages.dev,https://floodnet.netlify.app,https://dakshdahore1995-design.github.io,http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000",
    "FOUNDER_ALERT_EMAIL": "dakshdahore.d@gmail.com,lantern.mech@gmail.com",
    "EMAILJS_SERVICE_ID": "service_8yw2mtw",
    "EMAILJS_TEMPLATE_ID": "template_default",
    "EMAILJS_PUBLIC_KEY": "user_8yw2mtw",
    "OTP_DELIVERY_URL": "https://api.resend.com/emails",
    "OTP_FROM_ADDRESS": "MeteoFlood <onboarding@resend.dev>",
    "GOOGLE_CLIENT_ID": "719271873086-kpujid5noaftp00cc3lgf50fns212g3m.apps.googleusercontent.com",
    "FRONTEND_URL": "https://floodlock.pages.dev",
    "WORKER_SLOT": "HOT_STANDBY"
  }
}
