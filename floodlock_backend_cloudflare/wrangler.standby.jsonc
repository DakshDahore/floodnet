{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "floodlock-backend-standby",
  "main": "src/index.js",
  "compatibility_date": "2026-10-23",
  "triggers": {
    "crons": [
      "0 * * * *"
    ]
  },
  "observability": {
    "enabled": true
  },
  "ai": {
    "binding": "AI"
  },
  "kv_namespaces": [
    {
      "binding": "FLOODLOCK_KV",
      "id": "64ec69f748d3430fb3d34b8d6e59d8c3"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SECURITY_STATE_DO",
        "class_name": "SecurityStateDO",
        "script_name": "floodlock-backend"
      },
      {
        "name": "BILLING_STATE_DO",
        "class_name": "BillingStateDO",
        "script_name": "floodlock-backend"
      },
      {
        "name": "CIRCUIT_BREAKER_DO",
        "class_name": "CircuitBreakerDO",
        "script_name": "floodlock-backend"
      }
    ]
  },
  "vars": {
    "GROQ_MODEL": "openai/gpt-oss-120b",
    "GEMINI_MODEL": "gemini-2.5-flash",
    "ALLOWED_ORIGINS": "https://metoflood.netlify.app,https://floodlock.pages.dev,https://floodnet.netlify.app,https://dakshdahore1995-design.github.io",
    "EMAILJS_SERVICE_ID": "service_2s4fukw",
    "EMAILJS_TEMPLATE_ID": "template_spefc1e",
    "EMAILJS_PUBLIC_KEY": "JyA8ccT87iU8JnkPi",
    "OTP_DELIVERY_URL": "https://api.resend.com/emails",
    "OTP_FROM_ADDRESS": "MeteoFlood <onboarding@resend.dev>",
    "GOOGLE_CLIENT_ID": "337870843063-6ibga32hlca5b7s800dfdhm7prudl8j1.apps.googleusercontent.com",
    "GITHUB_CLIENT_ID": "Ov23liHMgDQduw9y5SOT",
    "FRONTEND_URL": "https://metoflood.netlify.app",
    "WORKER_SLOT": "HOT_STANDBY"
  },
  "services": [
    {
      "binding": "CORE_NEURAL",
      "service": "floodlock-core-neural"
    },
    {
      "binding": "CLICK_PROCESSOR",
      "service": "floodlock-click-processor"
    },
    {
      "binding": "SHARD_ASIA_SOUTH",
      "service": "floodlock-shard-asia-south"
    },
    {
      "binding": "SHARD_ASIA_EAST",
      "service": "floodlock-shard-asia-east"
    },
    {
      "binding": "SHARD_EUROPE_WEST",
      "service": "floodlock-shard-europe-west"
    },
    {
      "binding": "SHARD_EUROPE_MED",
      "service": "floodlock-shard-europe-med"
    },
    {
      "binding": "SHARD_NORTH_AMERICA",
      "service": "floodlock-shard-north-america"
    },
    {
      "binding": "SHARD_SOUTH_AMERICA",
      "service": "floodlock-shard-south-america"
    },
    {
      "binding": "SHARD_AFRICA_OCEANIA",
      "service": "floodlock-shard-africa-oceania"
    }
  ]
}