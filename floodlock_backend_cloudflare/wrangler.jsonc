{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "floodlock-backend",
  "main": "src/index.js",
  "compatibility_date": "2026-10-23",
  "observability": {
    "enabled": true
  },
  "ai": {
    "binding": "AI"
  },
  "kv_namespaces": [
    {
      "binding": "FLOODLOCK_KV",
      "id": "64ec69f748d3430fb3d34b8d6e59d8c3"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SECURITY_STATE_DO",
        "class_name": "SecurityStateDO"
      },
      {
        "name": "BILLING_STATE_DO",
        "class_name": "BillingStateDO"
      },
      {
        "name": "CIRCUIT_BREAKER_DO",
        "class_name": "CircuitBreakerDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-durable-state",
      "new_sqlite_classes": [
        "SecurityStateDO",
        "BillingStateDO",
        "CircuitBreakerDO"
      ]
    }
  ],
  "vars": {
    "GROQ_MODEL": "qwen/qwen3.8-27b",
    "GEMINI_MODEL": "gemini-3.8-flash",
    "ALLOWED_ORIGINS": "https://floodnet.netlify.app,https://dakshdahore1995-design.github.io,http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000",
    "FOUNDER_ALERT_EMAIL": "dakshdahore.d@gmail.com,lantern.mech@gmail.com",
    "EMAILJS_SERVICE_ID": "service_8yw2mtw",
    "EMAILJS_TEMPLATE_ID": "template_default",
    "EMAILJS_PUBLIC_KEY": "user_8yw2mtw",
    "OTP_DELIVERY_URL": "https://api.resend.com/emails",
    "OTP_FROM_ADDRESS": "auth@floodlock.org"
  }
}
