{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "floodlock-click-processor",
  "main": "src/click_processor.js",
  "compatibility_date": "2026-10-23",
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "FLOODLOCK_KV",
      "id": "64ec69f748d3430fb3d34b8d6e59d8c3"
    }
  ],
  "vars": {
    "WORKER_ROLE": "DEDICATED_USER_CLICK_PROCESSOR",
    "CORE_NAME": "floodlock-click-processor",
    "CORE_INDEX": "3",
    "GROQ_MODEL": "openai/gpt-oss-120b",
    "GEMINI_MODEL": "gemini-2.5-flash",
    "ALLOWED_ORIGINS": "https://metoflood.netlify.app,https://floodlock.pages.dev,https://floodnet.netlify.app,https://dakshdahore1995-design.github.io,http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000"
  }
}
