{
  "name": "floodlock-backend",
  "main": "src/index.js",
  "compatibility_date": "2026-10-23",
  "observability": { "enabled": true },
  "kv_namespaces": [
    // Create your own namespace: wrangler kv namespace create FLOODLOCK_KV
    { "binding": "FLOODLOCK_KV", "id": "REPLACE_WITH_YOUR_KV_ID" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "OTP_GUARD", "class_name": "OtpGuard" },
      { "name": "RATE_LIMITER", "class_name": "RateLimiter" },
      { "name": "ORDER_LEDGER", "class_name": "OrderLedger" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["OtpGuard", "RateLimiter", "OrderLedger"] }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://your-frontend.example",
    "GROQ_MODEL": "SET_A_MODEL_ID_FROM_GROQ_CONSOLE",
    "GEMINI_MODEL": "SET_A_CURRENT_GA_GEMINI_MODEL_ID"
  }
  // Secrets (never in this file):
  //   wrangler secret put OTP_PEPPER             (openssl rand -hex 32)
  //   wrangler secret put PII_KEY                (openssl rand -base64 32)
  //   wrangler secret put PAYMENT_WEBHOOK_SECRET
  //   wrangler secret put OTP_WEBHOOK_URL / OTP_WEBHOOK_TOKEN   (SMS/email provider)
  //   wrangler secret put GROQ_API_KEY / GEMINI_API_KEY
}
